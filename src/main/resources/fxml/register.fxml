<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hallbooking.controllers.RegisterController"
           styleClass="login-root"
           stylesheets="@../css/app.css"
           prefWidth="900" prefHeight="660">

    <VBox styleClass="login-card" alignment="CENTER" spacing="0"
          maxWidth="420">

        <Label text="Create Account" styleClass="lbl-login-title" alignment="CENTER">
            <VBox.margin><Insets bottom="4"/></VBox.margin>
        </Label>
        <Label text="Register as a new customer" styleClass="lbl-login-sub" alignment="CENTER">
            <VBox.margin><Insets bottom="22"/></VBox.margin>
        </Label>

        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
            </columnConstraints>

            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                <Label text="Full name" styleClass="field-label"/>
                <TextField fx:id="fullNameField" styleClass="field-input" promptText="Your full name"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                <Label text="Email address" styleClass="field-label"/>
                <TextField fx:id="emailField" styleClass="field-input" promptText="your@email.com"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" styleClass="field-input" promptText="Min 6 chars"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Confirm password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" styleClass="field-input" promptText="Confirm"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label text="Phone number" styleClass="field-label"/>
                <TextField fx:id="phoneField" styleClass="field-input" promptText="01X-XXXXXXX"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label text="Address" styleClass="field-label"/>
                <TextField fx:id="addressField" styleClass="field-input" promptText="City, State"/>
            </VBox>
        </GridPane>

        <Label fx:id="errorLabel" styleClass="lbl-error" text=""
               maxWidth="370" wrapText="true" alignment="CENTER">
            <VBox.margin><Insets top="12" bottom="4"/></VBox.margin>
        </Label>

        <Button text="Create Account" styleClass="btn-login" onAction="#handleRegister">
            <VBox.margin><Insets top="10" bottom="14"/></VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="4">
            <Label text="Already have an account?" styleClass="lbl-login-sub"/>
            <Hyperlink text="Sign in" onAction="#goToLogin"
                       style="-fx-text-fill:#2d7a50;-fx-font-size:12px;-fx-border-color:transparent;"/>
        </HBox>
    </VBox>
</StackPane>
