<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hallbooking.controllers.manager.ManagerDashboardController"
            stylesheets="@../../css/app.css"
            prefWidth="980" prefHeight="640">
    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-top">
                <StackPane styleClass="avatar-circle" alignment="CENTER"
                           style="-fx-min-width:54;-fx-min-height:54;-fx-max-width:54;-fx-max-height:54;">
                    <Label text="M" style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"/>
                </StackPane>
                <Label text="Welcome back," styleClass="lbl-welcome"/>
                <Label fx:id="lblUsername" text="Manager" styleClass="lbl-username"/>
                <Label text="Manager" styleClass="lbl-role"/>
            </VBox>

            <VBox styleClass="nav-container" VBox.vgrow="ALWAYS">
                <Button text="  Dashboard"       styleClass="nav-item, active" onAction="#goToDashboard"/>
                <Button text="  Sales Dashboard" styleClass="nav-item"         onAction="#goToSales"/>
                <Pane styleClass="sidebar-divider"/>
                <Button text="  Issue Management" styleClass="nav-item"        onAction="#goToIssues"/>
            </VBox>

            <VBox style="-fx-padding:8 10 14 10;">
                <Pane styleClass="sidebar-divider"/>
                <Button text="  Logout" styleClass="btn-logout" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox styleClass="topbar" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Manager Dashboard" styleClass="lbl-page-title"/>
                    <Label text="Hall Symphony — Operations Overview" styleClass="lbl-page-sub"/>
                </VBox>
            </HBox>

            <ScrollPane styleClass="scroll-pane" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox styleClass="content-area" spacing="16">

                    <HBox spacing="14">
                        <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="THIS MONTH REVENUE"  styleClass="stat-label"/>
                            <Label fx:id="statMonthly" text="RM 0" styleClass="stat-value"/>
                            <Label text="confirmed bookings"   styleClass="stat-sub"/>
                        </VBox>
                        <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="THIS YEAR REVENUE"   styleClass="stat-label"/>
                            <Label fx:id="statYearly" text="RM 0" styleClass="stat-value"/>
                            <Label text="year to date"         styleClass="stat-sub"/>
                        </VBox>
                        <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="OPEN ISSUES"         styleClass="stat-label"/>
                            <Label fx:id="statOpen"    text="0" styleClass="stat-value"/>
                            <Label text="need attention"       styleClass="stat-sub"/>
                        </VBox>
                        <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="TOTAL BOOKINGS"      styleClass="stat-label"/>
                            <Label fx:id="statBookings" text="0" styleClass="stat-value"/>
                            <Label text="all time confirmed"   styleClass="stat-sub"/>
                        </VBox>
                    </HBox>

                    <!-- Open issues -->
                    <VBox styleClass="card">
                        <HBox style="-fx-padding:12 16 12 16;-fx-border-color:transparent transparent #e8e4df transparent;-fx-border-width:0 0 1 0;" alignment="CENTER_LEFT">
                            <Label text="Open Issues" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1a2820;" HBox.hgrow="ALWAYS"/>
                            <Hyperlink text="Manage issues →" onAction="#goToIssues"
                                       style="-fx-text-fill:#2d7a50;-fx-font-size:12px;-fx-border-color:transparent;"/>
                        </HBox>
                        <TableView fx:id="issuesTable" prefHeight="210" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="iColId"      text="Issue ID"  prefWidth="80"/>
                                <TableColumn fx:id="iColTitle"   text="Title"     prefWidth="180"/>
                                <TableColumn fx:id="iColHall"    text="Hall"      prefWidth="130"/>
                                <TableColumn fx:id="iColCust"    text="Customer"  prefWidth="120"/>
                                <TableColumn fx:id="iColDate"    text="Reported"  prefWidth="130"/>
                                <TableColumn fx:id="iColStatus"  text="Status"    prefWidth="100"/>
                            </columns>
                            <placeholder><Label text="No open issues." style="-fx-text-fill:#b0ada8;"/></placeholder>
                        </TableView>
                    </VBox>

                    <!-- Monthly revenue summary -->
                    <VBox styleClass="card">
                        <HBox style="-fx-padding:12 16 12 16;-fx-border-color:transparent transparent #e8e4df transparent;-fx-border-width:0 0 1 0;" alignment="CENTER_LEFT">
                            <Label text="Recent Bookings Revenue" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1a2820;" HBox.hgrow="ALWAYS"/>
                            <Hyperlink text="Full sales report →" onAction="#goToSales"
                                       style="-fx-text-fill:#2d7a50;-fx-font-size:12px;-fx-border-color:transparent;"/>
                        </HBox>
                        <TableView fx:id="revenueTable" prefHeight="160" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="rColId"     text="Booking ID" prefWidth="90"/>
                                <TableColumn fx:id="rColHall"   text="Hall"       prefWidth="150"/>
                                <TableColumn fx:id="rColDate"   text="Event Date" prefWidth="120"/>
                                <TableColumn fx:id="rColHours"  text="Hours"      prefWidth="70"/>
                                <TableColumn fx:id="rColAmt"    text="Amount"     prefWidth="100"/>
                                <TableColumn fx:id="rColMethod" text="Payment"    prefWidth="120"/>
                            </columns>
                            <placeholder><Label text="No revenue data." style="-fx-text-fill:#b0ada8;"/></placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
