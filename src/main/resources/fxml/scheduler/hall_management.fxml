<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hallbooking.controllers.scheduler.HallManagementController"
            stylesheets="@../../css/app.css"
            prefWidth="980" prefHeight="640">
    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-top">
                <StackPane styleClass="avatar-circle" alignment="CENTER" style="-fx-min-width:54;-fx-min-height:54;-fx-max-width:54;-fx-max-height:54;">
                    <Label fx:id="lblAvatarInitial" text="S" style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"/>
                </StackPane>
                <Label text="Welcome back," styleClass="lbl-welcome"/>
                <Label fx:id="lblUsername" text="Scheduler" styleClass="lbl-username"/>
                <Label text="Scheduler" styleClass="lbl-role"/>
            </VBox>
            <VBox styleClass="nav-container" VBox.vgrow="ALWAYS">
                <Button text="  Dashboard"       styleClass="nav-item"         onAction="#goToDashboard"/>
                <Button text="  Hall Management" styleClass="nav-item, active" onAction="#goToHallManagement"/>
                <Pane styleClass="sidebar-divider"/>
                <Button text="  Availability"    styleClass="nav-item"         onAction="#goToAvailability"/>
                <Button text="  Maintenance"     styleClass="nav-item"         onAction="#goToMaintenance"/>
                <Pane styleClass="sidebar-divider"/>
                <Button text="  My Issues"       styleClass="nav-item"         onAction="#goToIssues"/>
            </VBox>
            <VBox style="-fx-padding:8 10 14 10;">
                <Pane styleClass="sidebar-divider"/>
                <Button text="  Logout" styleClass="btn-logout" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox>
            <HBox styleClass="topbar" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Hall Management" styleClass="lbl-page-title"/>
                    <Label text="Add, edit and manage all halls" styleClass="lbl-page-sub"/>
                </VBox>
                <TextField fx:id="searchField" styleClass="search-field"
                           promptText="Search halls..." onKeyReleased="#handleSearch"/>
            </HBox>
            <VBox styleClass="content-area" VBox.vgrow="ALWAYS" spacing="14">
                <VBox styleClass="card" VBox.vgrow="ALWAYS">
                    <TableView fx:id="hallTable" VBox.vgrow="ALWAYS" styleClass="table-view"
                               onMouseClicked="#onRowSelected">
                        <columns>
                            <TableColumn fx:id="colHallId"   text="Hall ID"     prefWidth="80"/>
                            <TableColumn fx:id="colName"     text="Hall Name"   prefWidth="180"/>
                            <TableColumn fx:id="colType"     text="Type"        prefWidth="130"/>
                            <TableColumn fx:id="colCapacity" text="Capacity"    prefWidth="90"/>
                            <TableColumn fx:id="colRate"     text="Rate / Hour" prefWidth="110"/>
                            <TableColumn fx:id="colDesc"     text="Description" prefWidth="200"/>
                            <TableColumn fx:id="colStatus"   text="Status"      prefWidth="80"/>
                        </columns>
                        <placeholder><Label text="No halls found." style="-fx-text-fill:#b0ada8;-fx-font-size:12px;"/></placeholder>
                    </TableView>
                </VBox>
                <VBox styleClass="form-card" spacing="12">
                    <Label text="Hall Details" styleClass="form-section-title"/>
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Hall ID" styleClass="field-label"/>
                            <TextField fx:id="fieldHallId" styleClass="field-input-readonly" editable="false" promptText="Auto-generated"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Hall Name" styleClass="field-label"/>
                            <TextField fx:id="fieldName" styleClass="field-input" promptText="e.g. Main Auditorium"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Hall Type" styleClass="field-label"/>
                            <ComboBox fx:id="comboType" styleClass="combo-box" maxWidth="10000"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Capacity (pax)" styleClass="field-label"/>
                            <TextField fx:id="fieldCapacity" styleClass="field-input" promptText="e.g. 1000"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Rate per Hour (RM)" styleClass="field-label"/>
                            <TextField fx:id="fieldRate" styleClass="field-input" promptText="e.g. 300.00"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label text="Description (optional)" styleClass="field-label"/>
                            <TextField fx:id="fieldDescription" styleClass="field-input" promptText="Brief description"/>
                        </VBox>
                    </GridPane>
                    <Label fx:id="errorLabel" styleClass="lbl-error" text="" wrapText="true"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Clear"    styleClass="btn-clear"  onAction="#handleClear"/>
                        <Button text="Delete"   styleClass="btn-delete" onAction="#handleDelete"/>
                        <Button text="Update"   styleClass="btn-update" onAction="#handleUpdate"/>
                        <Button text="Add Hall" styleClass="btn-add"    onAction="#handleAdd"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
